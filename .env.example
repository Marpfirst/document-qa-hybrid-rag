# --- LLM providers ---
# Gemini is primary (text + vision OCR). Get a key at https://aistudio.google.com/apikey
# IMPORTANT: do NOT enable billing on the Google Cloud project. Free tier = quota, not a bill.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq is the automatic fallback when Gemini returns 429/5xx. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: switch LLM_PROVIDER=anthropic to run on Claude with native citations.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Optional: switch LLM_PROVIDER=openai. No free tier — every call is billed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq

# --- Storage ---
# Leave QDRANT_URL empty to use embedded Qdrant at QDRANT_PATH.
QDRANT_PATH=./data/qdrant
QDRANT_URL=

# --- Demo guardrails ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
DEMO_ENABLED=true
DAILY_LLM_CALL_BUDGET=500
CORS_ORIGINS=http://localhost:3000

# --- OCR (release 2) ---
OCR_ENABLED=false
